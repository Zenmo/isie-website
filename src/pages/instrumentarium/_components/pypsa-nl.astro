---
import ContentWithImage from "@/components/ui/ContentWithImage.astro";
import Headline from "@/components/ui/Headline.astro";
import Paragraph from "@/components/ui/Paragraph.astro";
---

<ContentWithImage
  image="/consortium-logos/open-energy-transition.png"
  imageAlt="Logo van Open Energy Transition"
>
  <Headline tagline="Open Energy Transition" title="PyPSA-NL" />

  <Paragraph>
    PyPSA-NL is a Python-based optimization model for analyzing the Dutch energy
    system. It provides high spatial and temporal resolution for the Netherlands
    while also incorporating national energy targets consistent with the
    assumptions and scenarios of the TYNDP.
  </Paragraph>
</ContentWithImage>
