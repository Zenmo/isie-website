---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Features from "@/components/widgets/Features.astro";
import Content from "@/components/widgets/Content.astro";
import Form from "@/components/ui/Form.astro";
import { Icon } from "astro-icon/components";
import Card from "@/components/ui/Card.astro";
import IntroParagraph from "@/components/ui/IntroParagraph.astro";
import Paragraph from "@/components/ui/Paragraph.astro";
import Header from "@/components/ui/Header.astro";
import InlineLink from "@/components/ui/InlineLink.astro";

const metadata = {
  title: "Contact",
  description: "Get in touch with us to discuss your next project.",
};
---

<BaseLayout {metadata}>
  <Content title={metadata.title} />
  <IntroParagraph style="text-align: center;">
    Onderstaande contactpersonen helpen u graag verder als u vragen heeft over
    het project.
  </IntroParagraph>
  <Features
    classes={{ container: "pt-0 md:pt-0" }}
    features={[
      {
        title: "Lisanne Havinga",
        description: `
          Inhoudelijk projectmanager <br/><br/>
          <a href='mailto:lisanne.havinga@commonfutures.com'>lisanne.havinga@commonfutures.com</a>
        `,
        icon: "lucide:mail",
        iconClass: "bg-yellow-500/10 text-yellow-400",
      },
      {
        title: "Kees van der Leun",
        description: `
          Algemeen projectmanager <br/><br/>
          <a href='mailto:kees.vanderleun@commonfutures.com'>kees.vanderleun@commonfutures.com</a>
        `,
        icon: "lucide:mail",
        iconClass: "bg-blue-500/10 text-blue-400",
      },
    ]}
  />
  <Header style="text-align: center">Colofon</Header>
  <Paragraph style="text-align: center">
    De redactie van deze site is gedaan door Common Futures.
  </Paragraph>
  <Paragraph style="text-align: center">
    De broncode is te vinden op
    <InlineLink href="https://github.com/Zenmo/isie-website" />
  </Paragraph>
</BaseLayout>
