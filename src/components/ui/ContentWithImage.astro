---
import type { HTMLAttributes } from "astro/types";
type Props = {
  image: string;
  imageAlt: string;
} & HTMLAttributes<"div">;

const { image, imageAlt, ...rest } = Astro.props as Props;
---

<style>
  .row {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1rem;
    justify-content: center;
  }
  /* md */
  @media (width >= 48rem) {
    .row {
      flex-direction: var(--flex-direction, row);
      align-items: center;
    }
    .row > * {
      width: 50%;
      max-width: 40rem;
    }
  }

  .content-image {
    display: block;
    margin-inline: auto;
    width: 100%;
    border-radius: 0.5rem;
    background-color: #6b7280;
    box-shadow:
      0 10px 15px -3px rgba(0, 0, 0, 0.1),
      0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }
</style>

<div class="row" {...rest}>
  <div>
    <img src={image} alt={imageAlt} class="content-image" />
  </div>
  <div>
    <slot />
  </div>
</div>
