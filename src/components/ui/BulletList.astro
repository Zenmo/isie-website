---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"ul">;
---

<style>
  ul {
    font-weight: lighter;
    color: var(--color-muted-foreground);
    font-size: 1.125rem;
    list-style-type: disc;
    padding: revert;
    margin-bottom: 2rem;
  }
</style>

<ul {...Astro.props}>
  <slot />
</ul>
