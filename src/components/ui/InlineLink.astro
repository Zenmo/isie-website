---
import type { HTMLAttributes } from "astro/types";

export type Props = HTMLAttributes<"a"> & { href: string };

const href = Astro.props.href;

const fallbackLabel = href
  .toString()
  .replace("https://", "")
  .replace(/\/$/, "");
---

<style>
  a {
    color: var(--isie-deep-red);
    border-bottom: 1px solid var(--isie-red);
    font-weight: lighter;
  }
</style>

<a {...Astro.props}>
  <slot>{fallbackLabel}</slot>
</a>
