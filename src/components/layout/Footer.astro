---
import { siteConfig } from "@/config/site";
import { Icon } from "astro-icon/components";
---

<footer class="mt-20 border-t border-b border-border bg-card mb-16">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-8 md:flex-row">
      <div class="flex flex-col items-center gap-2 md:items-start">
        <span class="text-lg font-bold text-foreground">{siteConfig.name}</span>
        <p class="text-sm text-muted-foreground">
          Instrumentarium en Standaarden voor Integrale Energiesysteemanalyse.
        </p>
      </div>
      <div class="flex items-center gap-6">
        <a
          href="https://www.energy-innovation.nl/nl/over-ons/systeemintegratie/"
          target="_blank"
          rel="noopener noreferrer"
          class="energy-innovation-nl"
        >
          <img
            src="/energy-innovation-nl-light.svg"
            alt="Energy Innovation NL"
            class="dark:hidden"
            style="height: 3.5rem"
          />
          <img
            src="/energy-innovation-nl-light.svg"
            alt="Energy Innovation NL"
            class="not-dark:hidden"
            style="height: 3.5rem"
          />
        </a>
      </div>
    </div>
  </div>
</footer>
